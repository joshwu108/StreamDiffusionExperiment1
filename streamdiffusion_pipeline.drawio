(recurrent — reads previous timestep)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c3"><mxGeometry x="20" y="330" width="260" height="45" as="geometry"/></mxCell><mxCell id="c12" value="Upsample 2×
(space)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c3"><mxGeometry x="20" y="385" width="120" height="35" as="geometry"/></mxCell><mxCell id="c13" value="TGrow 2×
(time: 1 → 2 frames)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="c3"><mxGeometry x="160" y="385" width="120" height="35" as="geometry"/></mxCell><mxCell id="c14" value="conv n_f1 → n_f2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c3"><mxGeometry x="20" y="430" width="260" height="30" as="geometry"/></mxCell><mxCell id="c15" value="Stage 3: MemBlock ×3
(recurrent — reads previous timestep)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c3"><mxGeometry x="20" y="480" width="260" height="45" as="geometry"/></mxCell><mxCell id="c16" value="Upsample 2×
(space)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c3"><mxGeometry x="20" y="535" width="120" height="35" as="geometry"/></mxCell><mxCell id="c17" value="TGrow 2×
(time: 1 → 2 frames)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="c3"><mxGeometry x="160" y="535" width="120" height="35" as="geometry"/></mxCell><mxCell id="c18" value="conv n_f2 → n_f3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c3"><mxGeometry x="20" y="580" width="260" height="30" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="c3" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="c3" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="c3" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="c3" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="c3" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="c3" source="c8" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="c3" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="c3" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="c3" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="c3" source="c11" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="c3" source="c12" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="c3" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="c3" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="c3" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="c3" source="c15" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="c3" source="c16" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="c3" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="Output: 8× spatial, 4× temporal
1 latent → 4 pixel frames  N,4,3,480,832  RGB in [0,1]
(t_upscale = 2·2·1 = 4)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="340" y="640" width="260" height="55" as="geometry"/></mxCell><mxCell id="e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="&lt;b&gt;MemBlock = the &#x27;memory&#x27; cell&lt;/b&gt;&lt;br&gt;out = ReLU( conv3( cat[x, past] ) + skip(x) )&lt;br&gt;&lt;br&gt;&lt;b&gt;past&lt;/b&gt; = this same layer&#x27;s output at the &lt;i&gt;previous&lt;/i&gt; latent timestep. First timestep uses zeros. So a decode call at time t needs the memory left by t−1 — this is the causal state that Mode A throws away and Mode B keeps." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="340" y="60" width="300" height="150" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Mode A — decode_video(parallel=True)&lt;/b&gt;&lt;br&gt;Whole clip in one go, layer by layer. &#x27;past&#x27; = zero-padded shift of the same clip. No state survives across calls; first t_upscale−1 = 3 frames of every call are startup garbage and trimmed. Efficient only when T is large." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="225" width="300" height="120" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;Mode B — parallel=False / StreamingTAEHV.decode()&lt;/b&gt;&lt;br&gt;Per-frame work queue with a per-layer memory dict. Correct for streaming (state persists). But: one small kernel per layer per frame ⇒ launch-bound at small T. This is what V2 needs." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="355" width="300" height="120" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Mode C — batch across streams (N)&lt;/b&gt;&lt;br&gt;Run N independent videos in one call: the only parallelism that does not fight causality. Unused by V2 today (single stream). Sweep N in Step 1 to see if it recovers efficiency." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="485" width="300" height="120" as="geometry"/></mxCell><mxCell id="c45" value="Hypotheses  (each one = a measurable claim + the test that decides it)" style="text;html=1;fontStyle=1;fontSize=13;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="660" y="60" width="660" height="30" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;H1 (primary)  Decode is serialized on the final rank&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="660" y="100" width="200" height="105" as="geometry"/></mxCell><mxCell id="c47" value="DiT → decode → .cpu() run back-to-back on the compute stream. The final rank is the longest station, so FPS does not improve from 1 → 2 ranks. This is the pipeline-parallelism failure the plan is about." style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;align=left;verticalAlign=top;spacing=6;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="870" y="100" width="230" height="105" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Test:&lt;/b&gt; Step 3: per-rank CUDA-event timeline, 1 vs 2 ranks, --vae wan vs taehv; pipeline period = max stage; decode share of final-rank stage." style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;align=left;verticalAlign=top;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1110" y="100" width="210" height="105" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;H2  Scheduler under-weights decode&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="660" y="215" width="200" height="105" as="geometry"/></mxCell><mxCell id="c50" value="compute_balanced_split DOES receive t_dit + t_vae from the final rank (verified), but the rebalance is one-shot and uses the MINIMUM observed time, so decode is under-weighted and the final rank keeps too many DiT blocks." style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;align=left;verticalAlign=top;spacing=6;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="870" y="215" width="230" height="105" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;Test:&lt;/b&gt; Step 3: log block_num and each rank&#x27;s t_total / t_dit before and after rebalance; compare with a mean-based or repeated rebalance." style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;align=left;verticalAlign=top;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1110" y="215" width="210" height="105" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;H3 (demonstration)  Time-parallel path per chunk is wrong&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="660" y="330" width="200" height="105" as="geometry"/></mxCell><mxCell id="c53" value="decode_video(parallel=True) at T=1 resets MemBlock memory and trims 3 startup frames every call. It is a misuse of TAEHV&#x27;s offline parallelism, not a defect in TAEHV." style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;align=left;verticalAlign=top;spacing=6;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="870" y="330" width="230" height="105" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;Test:&lt;/b&gt; Step 1: round-trip equality; chunked Mode A ≠ streaming; count wasted frames. Step 2: --vae taehv_parallel in V2." style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;align=left;verticalAlign=top;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1110" y="330" width="210" height="105" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;Retired: launch-bound / small-tensor overheads&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="660" y="445" width="200" height="105" as="geometry"/></mxCell><mxCell id="c56" value="About TAEHV&#x27;s own per-call efficiency. Excluded by the working assumption &#x27;a single TAEHV decode is cheap&#x27;." style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;align=left;verticalAlign=top;spacing=6;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="870" y="445" width="230" height="105" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;Test:&lt;/b&gt; Step 1 tripwire: if T=1 streaming decode is not clearly cheaper than the final rank&#x27;s DiT share, reinstate these." style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;align=left;verticalAlign=top;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1110" y="445" width="210" height="105" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b&gt;Three meanings of &#x27;parallel&#x27; (only the first is under study)&lt;/b&gt;&lt;br&gt;1. &lt;b&gt;Pipeline parallelism across GPUs&lt;/b&gt;: DiT blocks are split across ranks; the decoder is not split and sits whole on the final rank. ← this plan.&lt;br&gt;2. &lt;b&gt;Time-axis parallelism inside TAEHV&lt;/b&gt; (parallel=True): all timesteps of a clip at once. V2 gives T=1, so there is nothing to parallelize; per-chunk use is the H3 misuse.&lt;br&gt;3. &lt;b&gt;Batch parallelism across streams&lt;/b&gt; (N): allowed by causality, unused by V2 (one stream). Possible fix only.&lt;br&gt;Root: MemBlocks are recurrent (t needs t−1). A recurrence pipelines across layers or batches across streams; it never parallelizes across time.&lt;br&gt;&lt;b&gt;Step 1 (sanity, ½ day)&lt;/b&gt;: ms/frame at T=1 for streaming, Mode A, and Wan baseline; one T=16 point; H3 equality test; small CSV." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="660" y="565" width="660" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4. Implementation breakdown" id="page4"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Page 4 — Work breakdown: Steps 0–5, each with sub-tasks, a &#x27;done when&#x27; check, and dependencies. Step 3 is the main step." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Solid arrows = hard dependencies. Steps 1 and 2 run in parallel; 3 needs 2; 4 needs Step 3&#x27;s evidence (Step 1 only feeds H3 and the tripwire). Effort is for one person with 2×A100." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="45" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Step 0 — Environment sanity  (~½ day)&lt;/b&gt;&lt;br&gt;&lt;br&gt;☐ Run README single-GPU inference.py on examples/original.mp4 (480×832, --step 2); keep the output mp4 as the reference.&lt;br&gt;☐ Run the 2-rank torchrun inference_pipe.py; confirm it finishes and log the printed FPS (anchor for Step 3).&lt;br&gt;☐ From the V2 venv: import /home/joshua/taehv/taehv.py, load safetensors/taew2_1.safetensors in bf16, decode a random [1,1,16,60,104] latent → expect [1,4,3,480,832].&lt;br&gt;☐ Record GPU/driver/torch versions in the report header.&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when:&lt;/b&gt; both README paths run; TAEHV loads and returns the expected shape." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="400" height="230" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Step 1 — Standalone decoder sanity check  (~½ day)&lt;/b&gt;&lt;br&gt;&lt;br&gt;☐ 1a  Script skeleton: load taew2_1 (bf16) and WanVAEWrapper; random latents [1,T,16,60,104]; CSV writer.&lt;br&gt;☐ 1b  Timing harness: CUDA events, 10 warm-up + 50 timed, ms per OUTPUT pixel frame.&lt;br&gt;☐ 1c  Points: StreamingTAEHV.decode T=1 (what V2 calls), Mode A T=1 (the misuse), Wan stream_decode T=1 (today&#x27;s baseline), plus Mode A and streaming at T=16.&lt;br&gt;☐ 1d  H3 correctness: 16-latent clip; streaming == full-clip Mode A (bf16 tol); chunked Mode A ≠ streaming; count trimmed frames.&lt;br&gt;☐ 1e  Tripwire: record T=1 streaming ms; Step 3 compares it to the final rank&#x27;s DiT share.&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when:&lt;/b&gt; CSV exists; T=1 decode cost known; H3 equality test passes." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="340" width="400" height="250" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Step 2 — Swappable TAEHV decoder inside V2  (~2 days)&lt;/b&gt;&lt;br&gt;&lt;br&gt;☐ 2a  TAEHVDecoderWrapper in causvid/models/wan/wan_wrapper.py: same stream_decode_to_pixel(latent) contract as WanVAEWrapper (in: [B,T,16,H/8,W/8] normalized; out: [B,T_px,3,H,W] in [-1,1]).&lt;br&gt;☐ 2b  Inside: permute to NTCHW → StreamingTAEHV.decode per latent → collect t_upscale=4 frames → map [0,1]→[-1,1]. Keep state across chunks; add reset().&lt;br&gt;☐ 2c  Latent-space check: take a real Wan latent from stream_encode, decode with both; report PSNR TAEHV-vs-Wan. Decide whether mean/std un-scaling is needed.&lt;br&gt;☐ 2d  Second variant &#x27;taehv_parallel&#x27; = naive per-chunk Mode A (the wrong/wasteful path, for H2 in situ).&lt;br&gt;☐ 2e  --vae {wan, taehv, taehv_parallel} flag in inference.py and inference_pipe.py; encoder stays Wan on rank 0.&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when:&lt;/b&gt; --vae taehv writes a video with the same frame count as --vae wan; PSNR reported." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="460" y="90" width="400" height="330" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Step 3 — Instrument the pipeline  (~2 days)  ← MAIN STEP&lt;/b&gt;&lt;br&gt;&lt;br&gt;☐ 3a  Final-rank loop: CUDA events around receive-wait (9), DiT (10), decode (12), host copy (13). Rank 0 / middle already time DiT + comm.&lt;br&gt;☐ 3b  Per-iteration JSON dump per rank (chunk idx, step idx, stage ms, block_num).&lt;br&gt;☐ 3c  Run matrix at 480×832, --step 2: {1 GPU inference.py, 2-rank inference_pipe.py} × {wan, taehv, taehv_parallel} × {schedule_block on, off}.&lt;br&gt;☐ 3d  Analysis: pipeline period = max stage time; decode share of final-rank stage; FPS; does FPS improve 1→2 ranks per decoder? (H1)&lt;br&gt;☐ 3e  Log block_num and each rank&#x27;s t_total / t_dit before/after rebalance (H2). Compare T=1 decode ms with the DiT share (Step 1 tripwire).&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when:&lt;/b&gt; JSON for every config; summary table reproduces README-style FPS for --vae wan; 1-vs-2-rank FPS ratio per decoder." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="460" y="440" width="400" height="300" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Step 4 — Attribute and validate fixes  (~3 days, only after 3)&lt;/b&gt;&lt;br&gt;&lt;br&gt;☐ 4a  H1 fix (a): run decode on a side CUDA stream so it overlaps the next receive + DiT. Measure final-rank stage ms and FPS before/after.&lt;br&gt;☐ 4b  H1 fix (c): pinned, non-blocking host copy instead of .cpu().float().numpy() in the loop.&lt;br&gt;☐ 4c  H1 fix (b), only if (a) cannot hide decode: a dedicated decode rank (world_size + 1) fed by the final DiT rank.&lt;br&gt;☐ 4d  H2 fix: mean-based timings and periodic re-scheduling in _handle_block_scheduling; compare block_num and final-rank stage time.&lt;br&gt;☐ 4e  Only if Step 1&#x27;s tripwire fired: batch latents across streams or CUDA-graph the single-step decoder.&lt;br&gt;☐ 4f  Report each fix as &#x27;final-rank stage ms before/after, pipeline FPS before/after, 1-rank vs 2-rank&#x27;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when:&lt;/b&gt; each validated fix has a before/after row; failed fixes stay in the report as negative results." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="900" y="90" width="420" height="400" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Step 5 — Write-up  (~1 day)&lt;/b&gt;&lt;br&gt;&lt;br&gt;☐ Answer the research question with numbers: which of H1–H3 held; whether the Step 1 tripwire fired.&lt;br&gt;☐ Decode share of the final-rank stage (%), 1-vs-2-rank FPS with each decoder.&lt;br&gt;☐ Measured effect of each validated fix.&lt;br&gt;☐ Attach CSV/JSON and the bench script; update this diagram with measured stage times.&lt;br&gt;&lt;br&gt;&lt;b&gt;Done when:&lt;/b&gt; a reader who was not here can reproduce every number from the artifacts." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="900" y="510" width="420" height="230" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="H3 + tripwire" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="465"/><mxPoint x="440" y="760"/><mxPoint x="880" y="760"/><mxPoint x="880" y="150"/></Array></mxGeometry></mxCell><mxCell id="e14" value="H1/H2 evidence (main path)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;Scope decision (2026-09-23).&lt;/b&gt; Working assumption: a single TAEHV decode call is cheap. The question is why that cheap call does not make the pipeline faster, i.e. pipeline parallelism across GPUs (meaning 1 on page 3). Launch-overhead hypotheses are retired; Step 1 is a half-day sanity check with a tripwire that reinstates them if T=1 decode is not cheap.&lt;br&gt;&lt;b&gt;Code check:&lt;/b&gt; the scheduler DOES receive decode time (inference_pipe.py:415); H2 is about it being one-shot and min-based, not invisible." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="20" y="610" width="400" height="130" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Files touched&lt;/b&gt;&lt;br&gt;New: examples/bench_taehv_decoder.py&lt;br&gt;Edit: causvid/models/wan/wan_wrapper.py, streamv2v/inference.py, streamv2v/inference_pipe.py&lt;br&gt;Reuse: /home/joshua/taehv/taehv.py&lt;br&gt;Untouched: /home/joshua/StreamDiffusion.git" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="400" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
