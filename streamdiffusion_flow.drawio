        <mxCell id="b1-17" value="&lt;div style=&quot;font-size:12px;color:#1A222C;line-height:14px;&quot;&gt;&lt;b&gt;Wan 2.1 VAE stream_encode&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#5F6B78;line-height:14px;&quot;&gt;causal 3D conv, feat_cache of 2&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#1A222C;line-height:14px;font-family:Courier New;&quot;&gt;→ [1, 1, 16, 60, 104] bf16&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DDF1EF;strokeColor=#0E7C7B;align=center;verticalAlign=middle;" vertex="1" parent="1">
