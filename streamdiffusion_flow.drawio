        <mxCell id="b1-12" value="&lt;div style=&quot;font-size:12px;color:#1A222C;line-height:14px;&quot;&gt;&lt;b&gt;Slice next chunk = 4 frames&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#5F6B78;line-height:14px;&quot;&gt;(first chunk: 5 frames → 2 latents)&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FBEBD6;strokeColor=#B4600A;align=center;verticalAlign=middle;" vertex="1" parent="1">
