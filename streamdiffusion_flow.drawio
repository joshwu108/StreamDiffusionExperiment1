        <mxCell id="a1-18" value="only this half runs inside V2 (pipeline stage 14)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#C0392B;fontStyle=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1">
