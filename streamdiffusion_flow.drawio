        </mxCell>
        <mxCell id="a2-64" value="Every MemBlock sees its own input from the previous frame (the recurrence, figure 4). The encoder never runs in V2; it is drawn so the decoder&amp;#x27;s mirror image is clear." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5F6B78;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1">
          <mxGeometry x="124.64" y="295" width="1038.72" height="19" as="geometry" />
        </mxCell>
        <mxCell id="a2-65" value="the model is one nn.Sequential; the runner (figure 5) decides whether the sequence is walked time-parallel or frame-by-frame" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5F6B78;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1">
          <mxGeometry x="257.08" y="327" width="773.84" height="19" as="geometry" />
        </mxCell>
        <mxCell id="a2-66" value="Encoder: three identical stages, each pooling time, halving space and running three recurrent blocks. Shapes are for 480×832 input." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#5F6B78;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1">
