        <mxCell id="b1-15" value="&lt;div style=&quot;font-size:12px;color:#1A222C;line-height:14px;&quot;&gt;&lt;b&gt;Motion-adaptive noise&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#5F6B78;line-height:14px;&quot;&gt;L2(frame_t − frame_{t−1}) → noise_scale s&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#1A222C;line-height:14px;font-family:Courier New;&quot;&gt;current_step ≈ 1000·s − 100&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B98A6;align=center;verticalAlign=middle;" vertex="1" parent="1">
