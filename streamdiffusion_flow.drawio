        </mxCell>
        <mxCell id="b1-10" value="&lt;div style=&quot;font-size:12px;color:#1A222C;line-height:14px;&quot;&gt;&lt;b&gt;Read mp4, resize to 480×832&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#1A222C;line-height:14px;font-family:Courier New;&quot;&gt;[1, 3, T, 480, 832] in [−1, 1]&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FBEBD6;strokeColor=#B4600A;align=center;verticalAlign=middle;" vertex="1" parent="1">
