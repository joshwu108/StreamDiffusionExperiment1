  <diagram id="flow-1" name="1 TAEHV round trip">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1220" pageHeight="330" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="a1-title" value="TAEHV round trip: pixels to latent to pixels, with the decoder half marked as the part V2 uses" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#5F6B78;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="310" width="1140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a1-2" value="&lt;div style=&quot;font-size:12px;color:#1A222C;line-height:15px;&quot;&gt;&lt;b&gt;Pixel frames&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#1A222C;line-height:15px;font-family:Courier New;&quot;&gt;N×T×3×480×832&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#5F6B78;line-height:15px;&quot;&gt;RGB in [0, 1]&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FBEBD6;strokeColor=#B4600A;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="70" width="190" height="96" as="geometry" />
        </mxCell>
        <mxCell id="a1-3" value="&lt;div style=&quot;font-size:12px;color:#1A222C;line-height:15px;&quot;&gt;&lt;b&gt;TAEHV encoder&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#5F6B78;line-height:15px;&quot;&gt;1.47 M params&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#5F6B78;line-height:15px;&quot;&gt;3 stages, causal&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B98A6;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="270" y="70" width="200" height="96" as="geometry" />
        </mxCell>
        <mxCell id="a1-4" value="&lt;div style=&quot;font-size:12px;color:#1A222C;line-height:15px;&quot;&gt;&lt;b&gt;Latent&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#1A222C;line-height:15px;font-family:Courier New;&quot;&gt;N×T/4×16×60×104&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#5F6B78;line-height:15px;&quot;&gt;≈ N(0,1), fed as-is to DiT&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DDF1EF;strokeColor=#0E7C7B;align=center;verticalAlign=middle;" vertex="1" parent="1">
