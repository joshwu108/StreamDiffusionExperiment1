          <mxGeometry x="418.64" y="35" width="422.72" height="19" as="geometry" />
        </mxCell>
        <mxCell id="a1-21" value="(un-normalizing with Wan mean/std costs 12 dB, Step 2)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5F6B78;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1">
          <mxGeometry x="458.68" y="49" width="342.64" height="19" as="geometry" />
        </mxCell>
        <mxCell id="a1-22" value="The whole autoencoder. Time shrinks 4× and space 8× on the way in; the decoder undoes both. V2 only ever calls the right half." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#5F6B78;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1">
