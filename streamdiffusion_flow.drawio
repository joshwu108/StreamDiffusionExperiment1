        <mxCell id="b1-19" value="&lt;div style=&quot;font-size:12px;color:#1A222C;line-height:14px;&quot;&gt;&lt;b&gt;SDEdit blend&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#1A222C;line-height:14px;font-family:Courier New;&quot;&gt;z = s·ε + (1 − s)·latent&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#5F6B78;line-height:14px;&quot;&gt;less noise when the scene is still&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B98A6;align=center;verticalAlign=middle;" vertex="1" parent="1">
