        <mxCell id="b2-122" value="ring back to rank 0: lands in slot 1 two iterations later, because rank 0 already started i+1 while rank 1 worked on B_i" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#5F6B78;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1">
          <mxGeometry x="524" y="351" width="749.2" height="19" as="geometry" />
        </mxCell>
        <mxCell id="b2-123" value="Each chunk visits 4 stations (2 ranks × 2 steps) and is decoded at iteration i+2. Once warm, one chunk (4 frames) comes out per iteration, so throughput = 1 / (slowest rank&amp;#x27;s iteration)." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5F6B78;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1">
          <mxGeometry x="107.12" y="375" width="1155.76" height="19" as="geometry" />
        </mxCell>
        <mxCell id="b2-124" value="How chunks move with 2 ranks and 2 denoising steps. Even and odd chunks share a rank in alternating iterations, so two stream-batches are in flight at once." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#5F6B78;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="421" width="970.96" height="19" as="geometry" />
        </mxCell>
