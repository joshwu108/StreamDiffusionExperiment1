        <mxCell id="a3-71" value="TGrow = 1×1 conv from C to stride·C channels, then reshape so each input frame becomes `stride` consecutive output frames. Stage 1 has stride 1, so t_upscale = 2·2 = 4." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5F6B78;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1">
          <mxGeometry x="192.56" y="277" width="1044.88" height="19" as="geometry" />
        </mxCell>
        <mxCell id="a3-72" value="Then decode_video / StreamingTAEHV drop the first t_upscale − 1 = 3 raw frames: they exist only to align the causal memory with the reference VAE." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5F6B78;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1">
          <mxGeometry x="260.32" y="295" width="909.36" height="19" as="geometry" />
        </mxCell>
        <mxCell id="a3-73" value="In V2 T_l = 1 per call: one latent in, 4 raw frames out, 4 frames kept after the first call. Measured 8.7 ms per call (Step 1)." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#C0392B;fontStyle=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1">
          <mxGeometry x="318.84" y="327" width="792.32" height="19" as="geometry" />
        </mxCell>
        <mxCell id="a3-74" value="Decoder: the mirror of the encoder. Space doubles at each stage; time doubles only in stages 2 and 3, so one latent becomes four frames." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#5F6B78;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="391" width="847.76" height="19" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
