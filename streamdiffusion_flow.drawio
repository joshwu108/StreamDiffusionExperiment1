        <mxCell id="b4-6" value="&lt;div style=&quot;font-size:12px;color:#1A222C;line-height:15px;&quot;&gt;&lt;b&gt;same contract as WanVAEWrapper&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#1A222C;line-height:15px;font-family:Courier New;&quot;&gt;stream_decode_to_pixel(latent)&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#5F6B78;line-height:15px;&quot;&gt;pipeline code unchanged&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FBEBD6;strokeColor=#B4600A;align=center;verticalAlign=middle;" vertex="1" parent="1">
