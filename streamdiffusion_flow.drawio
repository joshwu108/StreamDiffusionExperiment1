        <mxCell id="b1-27" value="&lt;div style=&quot;font-size:12px;color:#1A222C;line-height:14px;&quot;&gt;&lt;b&gt;Patchify + DiT blocks 0–14&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#5F6B78;line-height:14px;&quot;&gt;KV cache of 6 chunks, 3 sink tokens&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#1A222C;line-height:14px;font-family:Courier New;&quot;&gt;→ block_x [2, 3120, 1536]&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B98A6;align=center;verticalAlign=middle;" vertex="1" parent="1">
