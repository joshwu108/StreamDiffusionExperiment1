        </mxCell>
        <mxCell id="a4-29" value="Note: the plan says the memory is the layer&amp;#x27;s previous output. In the code it is the layer&amp;#x27;s previous input (memory[i] = xt)," style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#5F6B78;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="279" width="780" height="19" as="geometry" />
        </mxCell>
        <mxCell id="a4-30" value="which equals the previous layer&amp;#x27;s output at t−1. Same recurrence, shifted one layer earlier." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#5F6B78;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="295" width="576.72" height="19" as="geometry" />
        </mxCell>
        <mxCell id="a4-31" value="Recurrence rule: out_t depends on x_{t−1}, so frame t cannot start this layer until frame t−1 has reached it." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#5F6B78;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="317" width="681.44" height="19" as="geometry" />
        </mxCell>
        <mxCell id="a4-32" value="Across time this is a chain. Across layers it is a pipeline. Across independent streams it is a batch." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#5F6B78;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1">
