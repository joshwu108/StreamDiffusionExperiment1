        <mxCell id="a5-146" value="no red edges: memory is zero on every call," style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5F6B78;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1">
          <mxGeometry x="760.56" y="207" width="274.88" height="19" as="geometry" />
        </mxCell>
        <mxCell id="a5-147" value="so each chunk decodes as if it were frame 0," style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5F6B78;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1">
          <mxGeometry x="757.48" y="221" width="281.04" height="19" as="geometry" />
        </mxCell>
        <mxCell id="a5-148" value="and 3 of its 4 raw frames are trimmed as startup." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5F6B78;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1">
          <mxGeometry x="742.08" y="235" width="311.84" height="19" as="geometry" />
        </mxCell>
        <mxCell id="a5-149" value="9.0 ms/call, 1 wrong frame kept (24 of 81)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#C0392B;fontStyle=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=0;spacingRight=0;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="749.78" y="255" width="296.44" height="19" as="geometry" />
        </mxCell>
        <mxCell id="a5-150" value="rows = decoder layers, columns = latent timesteps · blue sweep = execution order · red = memory edge (x_{t−1})" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5F6B78;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1">
          <mxGeometry x="246.2" y="362" width="687.6" height="19" as="geometry" />
        </mxCell>
        <mxCell id="a5-151" value="Same weights, three runners. Only the middle one is both correct and usable one chunk at a time. The right one is hypothesis H3 and is what a naive per-chunk call to the fast path produces." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#5F6B78;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="411" width="1174.24" height="19" as="geometry" />
        </mxCell>
      </root>
