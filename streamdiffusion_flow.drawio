  <diagram id="flow-9" name="9 TAEHV wrapper contract">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1220" pageHeight="290" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="b4-title" value="The TAEHV wrapper inside stage 14: DiT latent in Wan&amp;#x27;s layout is permuted, fed to the streaming decoder one latent at a time, and four frames are collected and rescaled to the Wan output contract" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#5F6B78;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="270" width="1140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b4-2" value="&lt;div style=&quot;font-size:12px;color:#1A222C;line-height:15px;&quot;&gt;&lt;b&gt;x0[[−1]] from DiT&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#1A222C;line-height:15px;font-family:Courier New;&quot;&gt;[1, 1, 16, 60, 104]&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#5F6B78;line-height:15px;&quot;&gt;Wan-normalized, bf16&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DDF1EF;strokeColor=#0E7C7B;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="56" width="190" height="78" as="geometry" />
        </mxCell>
        <mxCell id="b4-3" value="&lt;div style=&quot;font-size:12px;color:#1A222C;line-height:15px;&quot;&gt;&lt;b&gt;permute&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#5F6B78;line-height:15px;&quot;&gt;already N,T,C,H,W&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#5F6B78;line-height:15px;&quot;&gt;no mean/std scaling&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B98A6;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="250" y="56" width="150" height="78" as="geometry" />
        </mxCell>
        <mxCell id="b4-4" value="&lt;div style=&quot;font-size:12px;color:#1A222C;line-height:15px;&quot;&gt;&lt;b&gt;StreamingTAEHV.decode(z)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#1A222C;line-height:15px;font-family:Courier New;&quot;&gt;→ frame 1, then decode()×3&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#5F6B78;line-height:15px;&quot;&gt;MemBlock memory persists&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F9E0DC;strokeColor=#C0392B;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="440" y="56" width="210" height="78" as="geometry" />
        </mxCell>
        <mxCell id="b4-5" value="&lt;div style=&quot;font-size:12px;color:#1A222C;line-height:15px;&quot;&gt;&lt;b&gt;stack 4 frames&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#1A222C;line-height:15px;font-family:Courier New;&quot;&gt;[1, 4, 3, 480, 832]&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#5F6B78;line-height:15px;&quot;&gt;[0, 1] → [−1, 1]&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B98A6;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="690" y="56" width="170" height="78" as="geometry" />
