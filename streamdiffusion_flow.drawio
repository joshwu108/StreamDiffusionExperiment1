        </mxCell>
        <mxCell id="a1-19" value="rank 0 keeps the Wan 2.1 encoder" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5F6B78;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="1">
